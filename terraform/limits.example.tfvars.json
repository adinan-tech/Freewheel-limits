{
  "region": "<CHANGE HERE: OCI region, for example eu-frankfurt-1>",
  "home_region": "<CHANGE HERE: tenancy home region, for example us-ashburn-1>",
  "tenancy_id": "<CHANGE HERE: tenancy OCID>",
  "function_compartment_id": "<CHANGE HERE: Function compartment OCID>",
  "archive_bucket_name": null,
  "subnet_id": "<CHANGE HERE: subnet OCID with OCI API egress>",
  "schedule_start_utc": "<CHANGE HERE: future UTC time, for example 2026-12-31T12:00:00Z>",
  "check_schedule_utc": "15 * * * *",
  "email_recipients": [
    "<CHANGE HERE: alert recipient email>"
  ],
  "monitors": {
    "compute_standard3_cores": {
      "service_name": "compute",
      "limit_name": "standard3-core-count",
      "availability_domain": "<CHANGE HERE: availability domain>",
      "warning_percent": 80
    },
    "compute_standard_e4_cores": {
      "service_name": "compute",
      "limit_name": "standard-e4-core-count",
      "availability_domain": "<CHANGE HERE: availability domain>",
      "warning_percent": 80
    },
    "compute_standard_e5_cores": {
      "service_name": "compute",
      "limit_name": "standard-e5-core-count",
      "availability_domain": "<CHANGE HERE: availability domain>",
      "warning_percent": 80
    },
    "compute_custom_images": {
      "service_name": "compute",
      "limit_name": "custom-image-count",
      "availability_domain": null,
      "warning_percent": 80
    },
    "block_volume_count": {
      "service_name": "block-storage",
      "limit_name": "volume-count",
      "availability_domain": "<CHANGE HERE: availability domain>",
      "warning_percent": 80
